# Required Telegram BotFather token
BOT_TOKEN=replace_with_your_telegram_bot_token
# Telegram user IDs allowed to use admin commands (comma separated)
ADMINS=
# API keys from OpenWeatherMap and NewsAPI
OPENWEATHER_KEY=replace_with_your_openweathermap_key
NEWSAPI_KEY=replace_with_your_newsapi_key
# Optional: path to Tesseract executable (defaults to tesseract on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
